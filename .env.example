# ============================================
# LitReview Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---- LLM Configuration ----
# Synthesis uses Gemini by default; switch provider without changing code.
OPENAI_API_KEY=
OPENAI_API_BASE=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MODEL_NAME=gpt-4o-mini
SYNTHESIS_LLM_PROVIDER=openai
SYNTHESIS_MODEL=gpt-4o-mini
SYNTHESIS_LLM_MAX_CONCURRENCY=1
SYNTHESIS_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small

# This provider configures the shared Chat/RAG vector store only.
# Fast v2 uses its own dedicated local MiniLM collection and does not read it.
EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Fast Synthesis v2 ----
# Hosted generation uses xkiro's OpenAI-compatible endpoint.
# Set FAST_V2_HOSTED_API_KEY in local .env or the Render environment dashboard.
# Never commit a real key.
SYNTHESIS_MODE=fast_v2_experimental
FAST_V2_GENERATOR=hosted_api
FAST_V2_RERANKER=cross_encoder
FAST_V2_HOSTED_API_BASE_URL=https://api.xkiro.com/v1
FAST_V2_HOSTED_API_MODEL=deepseek/deepseek-v4-flash
FAST_V2_HOSTED_API_KEY=

# Fast v2 semantic retrieval is independent from EMBEDDING_PROVIDER above.
# Dockerfile bakes these local Hugging Face models into the production image:
# - sentence-transformers/all-MiniLM-L6-v2
# - cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Database ----
# Local Python development:
DATABASE_URL=postgresql://postgres:password@localhost:5434/litreview
# Docker Compose overrides this with db:5432 and asyncpg automatically.
# SQLite fallback:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
# Empty CHROMA_HOST => embedded Chroma, safe only for single-process local dev.
# For a separately running Chroma server use localhost:8001 from the host.
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_PERSIST_DIR=./data/chroma

# ---- Background synthesis ----
# Host-local Redis; Docker Compose overrides host to redis:6379.
REDIS_URL=redis://localhost:6379/0
SYNTHESIS_MAX_PAPERS=15

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (optional) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=litreview-agent
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Usage Logging (Required for course tracking) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log


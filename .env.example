# ============================================
# LitReview Agent — Backend environment
# ============================================
# Copy to .env and fill in. NEVER commit .env.
#
# Two rules worth knowing before you edit anything below:
#
#   1. Values here must match the code's own safe defaults. This file used to
#      turn on the experimental synthesis pipeline and a model-downloading
#      reranker, so anyone who copied it ran a different system from anyone who
#      did not -- with nothing on screen to say so.
#
#   2. LLM settings can be changed freely. Embedding settings cannot: they
#      define the coordinate space of everything already indexed. See the
#      EMBEDDING section.

# ---- Security (required) ----
# The app refuses to start without this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It signs every access token: a shared or guessable value lets anyone mint one.
SECRET_KEY=

# Google OAuth. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Development-only convenience. Seeding is rejected unless APP_ENV=development
# and SEED_ADMIN_PASSWORD is set. (An admin account was previously created on
# every startup in every environment with the password "123".)
SEED_DEFAULT_ADMIN=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Two ready-made researcher profiles on the sign-in screen, for trying the app
# without filling in the signup form. They are real accounts: clicking one runs
# a normal login and gets a normal token, so everything afterwards is authorised
# like any other session. The shared password is served to the browser, which is
# why this is refused outside APP_ENV=development.
SEED_DEMO_ACCOUNTS=false
SEED_DEMO_PASSWORD=

# ---- LLM provider routing ----
# Order in which providers are tried. Each person sets their own here, so
# preferring the keys you actually have never means editing a shared file.
LLM_PROVIDER_PRIORITY=gemini,openai,groq

# Model per provider, kept separate from the credential: rotating a key must
# never change which model runs. Base URLs come from the registry
# (src/services/llm/registry.py), not from inspecting the key's prefix.
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# Several keys for one provider, with aliases so logs can name the key that
# spent money without printing it. A key reporting quota exhaustion is set
# aside briefly; a key the provider rejects is disabled for the process.
#   GEMINI_API_KEYS=lien:AIza...,huyen:AIza...,team:AIza...

# ---- LLM (safe to change at any time) ----
# Generation is stateless: switching provider or model changes the quality of a
# response, not the meaning of anything already stored.
#
# Set the key for whichever provider you intend to use. If none is set, calls
# raise a configuration error instead of issuing failing billed requests.
OPENAI_API_KEY=
OPENAI_API_BASE=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

MODEL_NAME=gpt-4o-mini
LLM_PROVIDER=
LLM_TEMPERATURE=0.7

SYNTHESIS_LLM_PROVIDER=openai
SYNTHESIS_MODEL=gpt-4o-mini
SYNTHESIS_LLM_MAX_CONCURRENCY=1
SYNTHESIS_TEMPERATURE=0.0
SYNTHESIS_MAX_PAPERS=15

# ---- EMBEDDING (changing these requires re-indexing) ----
# An embedding model defines the vector space of the Chroma collection. Vectors
# written by one model cannot be searched with another, even at the same
# dimensionality -- the results look plausible and mean nothing.
#
# Rotating an API key within the same provider AND model is safe and needs no
# re-index. Changing EMBEDDING_PROVIDER or EMBEDDING_MODEL is a data migration.
#
# Valid providers: openai | gemini | local | hash-debug
#   local       real sentence-transformers model, downloads on first use
#   hash-debug  non-semantic word hashes; smoke tests only, never production
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Used only when EMBEDDING_PROVIDER=local.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: a separate key/endpoint for embeddings, if they are billed apart
# from generation.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_API_BASE=

# ---- Academic search ----
# One canonical name. The code previously read SERPAPI_KEY in one place and
# SERPAPI_API_KEY in another, so setting one name made half the search paths
# work and left the other half silently receiving an empty string.
SERPAPI_API_KEY=

# ---- Database ----
# There is no automatic fallback. If this database is unreachable the app stops
# with an error rather than quietly writing to a local SQLite file that
# disappears on the next restart.
#
# Default local setup (`docker compose up -d db` publishes Postgres on 5434):
DATABASE_URL=postgresql://postgres:password@localhost:5434/litreview
# To work without Docker, choose SQLite explicitly instead:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector store ----
# Empty CHROMA_HOST uses embedded Chroma: single process only. The API and a
# Celery worker running embedded each get their own private store.
# Docker Compose sets CHROMA_HOST=chroma with CHROMA_PORT=8000 (in-container).
# From the host, the same container is published on 8001.
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_PERSIST_DIR=./data/chroma

# ---- Background synthesis ----
# Docker Compose overrides the host to redis:6379.
REDIS_URL=redis://localhost:6379/0

# ---- Fast Synthesis v2 (EXPERIMENTAL — off by default) ----
# Keep SYNTHESIS_MODE=legacy. fast_v2's latency is validated; its claim-level
# factual grounding is not. See docs/architecture/FAST_SYNTHESIS_V2.md
# section M for the criteria it must meet before becoming the default.
SYNTHESIS_MODE=legacy
# "fake" loads and calls nothing. "hosted_api" needs the three settings below.
FAST_V2_GENERATOR=fake
# "identity" performs no reranking. "cross_encoder" downloads a checkpoint on
# first use.
FAST_V2_RERANKER=identity
FAST_V2_HOSTED_API_BASE_URL=
FAST_V2_HOSTED_API_MODEL=
FAST_V2_HOSTED_API_KEY=
FAST_V2_OPENSCHOLAR_BASE_URL=

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Comma-separated. Now actually applied to the CORS middleware, which was
# previously pinned to "*" and ignored this setting entirely. The first entry
# is also where the OAuth callback redirects.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- LangSmith (optional) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=litreview-agent
LANGCHAIN_TRACING_V2=false

# ---- AI usage logging (course tracking) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

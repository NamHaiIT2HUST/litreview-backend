# ============================================
# LitReview Agent — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---- LLM Configuration ----
# Synthesis uses Gemini by default; switch provider without changing code.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MODEL_NAME=gemini-1.5-flash
SYNTHESIS_LLM_PROVIDER=gemini
SYNTHESIS_MODEL=gemini-3.5-flash-lite
SYNTHESIS_LLM_MAX_CONCURRENCY=1
SYNTHESIS_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-004

# ---- Database ----
# Local Python development:
DATABASE_URL=postgresql://postgres:password@localhost:5434/litreview
# Docker Compose overrides this with db:5432 and asyncpg automatically.
# SQLite fallback:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
# Empty CHROMA_HOST => embedded Chroma, safe only for single-process local dev.
# For a separately running Chroma server use localhost:8001 from the host.
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_PERSIST_DIR=./data/chroma

# ---- Background synthesis ----
# Host-local Redis; Docker Compose overrides host to redis:6379.
REDIS_URL=redis://localhost:6379/0
SYNTHESIS_MAX_PAPERS=15

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (optional) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=litreview-agent
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

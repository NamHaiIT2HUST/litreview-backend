# ============================================
# LitReview Agent — Frontend environment
# ============================================
# Copy to frontend/.env.local and fill in. NEVER commit a real .env.
#
# Vite only exposes variables prefixed with VITE_, and it inlines them at build
# time — a production bundle carries whatever was set when it was built.
#
# This file did not exist before. Because nothing told anyone VITE_API_BASE
# existed, nobody set it, and a hardcoded fallback inside apiConfig.js decided
# which backend each branch talked to. Different branches carried different
# fallbacks, so two developers could be reading and writing two entirely
# different backends without knowing.

# ---- Backend API base URL (required for production builds) ----
# Include the /api/v1 suffix.
#
# Local development, backend running directly on the host:
VITE_API_BASE=http://localhost:8000/api/v1
#
# Deployed behind a proxy that forwards /api/v1 to the backend (the Vercel
# rewrite in vercel.json does this), use a relative path so the browser never
# needs the backend's address:
# VITE_API_BASE=/api/v1
#
# Talking directly to a deployed backend:
# VITE_API_BASE=https://api.example.com/api/v1
#
# Note: a browser on an HTTPS page cannot call an http:// backend — mixed
# content is blocked. Serve the backend over HTTPS or proxy it same-origin.

# ---- Google Sign-In ----
# Must match GOOGLE_CLIENT_ID in the backend .env: the backend verifies the
# ID token's audience against its own value. Leave blank to disable the
# Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
